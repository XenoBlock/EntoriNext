#!/bin/sh
# Komodo rcS - minimal bringup
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /dev/shm 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
# mdev for device nodes if available (hotplug is no-op if ro)
mdev -s 2>/dev/null
# hostname
hostname -F /etc/hostname 2>/dev/null || hostname Komodo 2>/dev/null
# message
echo ""
echo "Welcome to Komodo 630.0.0 (hybrid) on x86_64"
echo "Type 'help' for busybox commands."
echo ""
